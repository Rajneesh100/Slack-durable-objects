{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "USERS",
        "class_name": "UserDO"
      },
      {
        "name": "ROOMS",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "RoomDO"]
    }
  ]
}
